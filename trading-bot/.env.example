# Copy this file to .env and fill it in. Never commit .env.

# --- Broker: Alpaca (https://alpaca.markets) -------------------------------
# Create a PAPER account first and use its keys. Paper keys only work against
# the paper endpoint, so a mix-up fails safely.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# paper (default) or live.
TRADING_MODE=paper
# Live trading also needs this exact phrase. Leave it empty until the bot has
# run on paper long enough for you to trust it.
LIVE_TRADING_CONFIRM=

# How much of the account the bot may trade with, in any currency the broker
# quotes against the dollar, e.g. "£100" or "100 GBP". Leave empty to use the
# whole account. A paper account starts with $100,000 of pretend money.
BOT_CAPITAL=

# --- News analysis: Claude (https://console.anthropic.com) ----------------
# Without a key the bot falls back to a much weaker keyword scorer.
ANTHROPIC_API_KEY=

# --- Optional sources ------------------------------------------------------
# SEC EDGAR requires a User-Agent naming you and a contact address, for
# example "Jane Doe jane@example.com". The SEC filings source stays off until
# this is set.
SEC_USER_AGENT=

# Path to a JSON file overriding any setting in src/config.js (optional).
# BOT_CONFIG=config.json
